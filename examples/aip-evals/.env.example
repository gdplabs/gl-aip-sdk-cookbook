# GL AIP API Configuration
# Copy this file to .env and fill in your values

# Required for 01_local_eval.py and 02_remote_eval.py: used as the LLM
# judge for the model-based metrics (completeness, groundedness).
OPENAI_API_KEY=

# Required for 02_remote_eval.py only (hosted execution).
# Get these from the AIP platform console.
AIP_API_URL=
AIP_API_KEY=
